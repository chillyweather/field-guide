# Copy to .env.local and fill in. .env.local is gitignored and is never printed
# by anything in this repo — the probes read it directly so keys do not travel
# through a command line, shell history, or a session transcript.

TYPESAFE_API_KEY=

# Any OpenAI-compatible vision host.
#
# OpenAI is the default. OpenCode Go also carries a vision model, but its docs
# state it is for "OpenCode and other coding agents that produce similar types
# of requests" and its traffic is monitored — screenshots to a vision model are
# not that, whatever headers are attached.
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
