# Copy to .env.local and fill in. .env.local is gitignored and is never printed
# by anything in this repo — the probes read it directly so keys do not travel
# through a command line, shell history, or a session transcript.

TYPESAFE_API_KEY=

# Any OpenAI-compatible vision host.
#
# OpenCode Go and OpenCode Zen are different products on different paths and
# carry different catalogues:
#   Go   https://opencode.ai/zen/go/v1    subscription, one vision model
#   Zen  https://opencode.ai/zen/v1       pay as you go
#   OpenAI  https://api.openai.com/v1     the fallback if Go's vision model is unfit
VISION_API_KEY=
VISION_BASE_URL=https://opencode.ai/zen/go/v1
